    private void CloseCheckout()
    {
        if (IsSubmittingOrder)
            return;

        ShowCheckout = false;

        CheckoutError = null;
    }


    private async Task SubmitOrder()
    {
        if (IsSubmittingOrder)
            return;

        if (!IsAuthenticated)
        {
            GoToLogin();
            return;
        }


        if (!Cart.Any())
        {
            CheckoutError =
                "Your cart is empty.";

            return;
        }


        IsSubmittingOrder = true;

        CheckoutError = null;


        try
        {
            // -------------------------------------------------
            // RELOAD PRODUCTS
            // This prevents stale stock from being ordered.
            // -------------------------------------------------

            var productIds =
                Cart.Select(x => x.Product.ProductId)
                    .ToList();


            var databaseProducts =
                await Db.Products
                    .Where(p =>
                        productIds.Contains(p.ProductId))
                    .ToDictionaryAsync(
                        p => p.ProductId);


            // -------------------------------------------------
            // VALIDATE STOCK
            // -------------------------------------------------

            foreach (var item in Cart)
            {
                if (!databaseProducts.TryGetValue(
                        item.Product.ProductId,
                        out var databaseProduct))
                {
                    CheckoutError =
                        $"{item.Product.Name} is no longer available.";

                    return;
                }


                if (databaseProduct.Quantity < item.Quantity)
                {
                    CheckoutError =
                        $"There are only {databaseProduct.Quantity} " +
                        $"unit(s) of {databaseProduct.Name} available.";

                    return;
                }
            }


            // -------------------------------------------------
            // CALCULATE TOTAL FROM DATABASE PRICES
            // -------------------------------------------------

            decimal total = 0;


            foreach (var item in Cart)
            {
                var databaseProduct =
                    databaseProducts[item.Product.ProductId];

                total +=
                    databaseProduct.Price *
                    item.Quantity;
            }


            // -------------------------------------------------
            // CREATE ORDER
            // -------------------------------------------------

            var order = new Order
            {
                OrderId = Guid.NewGuid(),

                UserId = CurrentUserId,

                OrderDate = DateTime.UtcNow,

                Status = OrderStatus.Pending,

                PaymentType = SelectedPaymentType,

                TotalAmount = total
            };


            foreach (var item in Cart)
            {
                var databaseProduct =
                    databaseProducts[item.Product.ProductId];


                order.OrderItems.Add(
                    new OrderItem
                    {
                        OrderItemId = Guid.NewGuid(),

                        OrderId = order.OrderId,

                        ProductId =
                            databaseProduct.ProductId,

                        Quantity = item.Quantity,

                        Price = databaseProduct.Price
                    });


                databaseProduct.Quantity -=
                    item.Quantity;
            }


            Db.Orders.Add(order);


            // -------------------------------------------------
            // CREATE PAYMENT RECORD
            //
            // This records the selected payment method.
            // It does NOT process an actual payment.
            // -------------------------------------------------

            Db.Payments.Add(
                new Payment
                {
                    PaymentId = Guid.NewGuid(),

                    OrderId = order.OrderId,

                    Amount = total,

                    PaymentType =
                        SelectedPaymentType,

                    PaymentStatus =
                        PaymentStatus.Pending,

                    PaymentDate =
                        DateTime.UtcNow
                });


            await Db.SaveChangesAsync();


            // -------------------------------------------------
            // REFRESH STORE
            // -------------------------------------------------

            Cart.Clear();

            await LoadStoreData();

            await LoadCustomerOrders();


            ShowCheckout = false;

            SuccessMessage =
                $"Order #{order.OrderId.ToString()[..8].ToUpper()} " +
                "was submitted successfully.";

        }
        catch (DbUpdateException)
        {
            CheckoutError =
                "The order could not be saved. " +
                "Please try again.";
        }
        catch (Exception)
        {
            CheckoutError =
                "Something went wrong while submitting " +
                "your order.";
        }
        finally
        {
            IsSubmittingOrder = false;
        }
    }


