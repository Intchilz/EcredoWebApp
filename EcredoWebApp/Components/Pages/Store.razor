    // =========================================================
    // SWAP REQUEST
    // =========================================================

    private void OpenSwapModal()
    {
        if (!IsAuthenticated)
        {
            GoToLogin();
            return;
        }


        SwapError = null;

        SwapModel = new SwapRequestInput();

        ShowSwapModal = true;
    }


    private void CloseSwapModal()
    {
        if (IsSubmittingSwap)
            return;

        ShowSwapModal = false;

        SwapError = null;
    }


    private async Task SubmitSwapRequest()
    {
        if (IsSubmittingSwap)
            return;


        if (!IsAuthenticated)
        {
            GoToLogin();
            return;
        }


        SwapError = ValidateSwap();


        if (!string.IsNullOrWhiteSpace(SwapError))
            return;


        IsSubmittingSwap = true;


        try
        {
            var request = new SwapRequest
            {
                SwapRequestId = Guid.NewGuid(),

                UserId = CurrentUserId,

                CurrentDeviceBrand =
                    SwapModel.CurrentDeviceBrand.Trim(),

                CurrentDeviceModel =
                    SwapModel.CurrentDeviceModel.Trim(),

                DeviceCondition =
                    SwapModel.DeviceCondition.Trim(),

                FaultDescription =
                    string.IsNullOrWhiteSpace(
                        SwapModel.FaultDescription)
                        ? null
                        : SwapModel.FaultDescription.Trim(),

                DesiredDevice =
                    SwapModel.DesiredDevice.Trim(),

                EstimatedTopUpAmount =
                    SwapModel.EstimatedTopUpAmount,

                Status =
                    SwapRequestStatus.Pending,

                CreatedAt =
                    DateTime.UtcNow
            };


            Db.SwapRequests.Add(request);

            await Db.SaveChangesAsync();


            ShowSwapModal = false;

            SuccessMessage =
                $"Swap request #{request.SwapRequestId.ToString()[..8].ToUpper()} " +
                "was submitted successfully.";

        }
        catch (DbUpdateException)
        {
            SwapError =
                "The swap request could not be saved. " +
                "Please try again.";
        }
        catch (Exception)
        {
            SwapError =
                "Something went wrong while submitting " +
                "your swap request.";
        }
        finally
        {
            IsSubmittingSwap = false;
        }
    }


    private string? ValidateSwap()
    {
        if (string.IsNullOrWhiteSpace(
                SwapModel.CurrentDeviceBrand))
            return "Please enter your current device brand.";

        if (string.IsNullOrWhiteSpace(
                SwapModel.CurrentDeviceModel))
            return "Please enter your current device model.";

        if (string.IsNullOrWhiteSpace(
                SwapModel.DeviceCondition))
            return "Please describe the condition of your device.";

        if (string.IsNullOrWhiteSpace(
                SwapModel.DesiredDevice))
            return "Please enter the device you want.";

        if (SwapModel.EstimatedTopUpAmount < 0)
            return "The top-up amount cannot be negative.";

        return null;
    }


