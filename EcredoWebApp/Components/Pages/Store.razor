    // =========================================================
    // CART
    // =========================================================

    private void AddToCart(Product product)
    {
        if (!IsAuthenticated)
        {
            GoToLogin();
            return;
        }


        if (product.Quantity <= 0)
            return;


        var existing =
            Cart.FirstOrDefault(x =>
                x.Product.ProductId ==
                product.ProductId);


        if (existing != null)
        {
            if (existing.Quantity < product.Quantity)
            {
                existing.Quantity++;
            }
        }
        else
        {
            Cart.Add(new CartItem
            {
                Product = product,
                Quantity = 1
            });
        }
    }


    private bool IsInCart(Guid productId)
    {
        return Cart.Any(x =>
            x.Product.ProductId == productId);
    }


    private void IncreaseQuantity(CartItem item)
    {
        if (item.Quantity >= item.Product.Quantity)
            return;

        item.Quantity++;
    }


    private void DecreaseQuantity(CartItem item)
    {
        if (item.Quantity <= 1)
        {
            Cart.Remove(item);
            return;
        }

        item.Quantity--;
    }


    private void RemoveFromCart(CartItem item)
    {
        Cart.Remove(item);
    }


